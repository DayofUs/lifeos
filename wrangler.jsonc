
{

"keep_vars": true,
  "name": "lifeos-zac",
  "compatibility_date": "2026-11-19",
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ]
}
